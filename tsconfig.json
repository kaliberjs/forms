{
  "typeAcquisition": {
    "enable": true
  },
  "include": [
    "src/**/*", 
    "types/**/*"
  ],
  "exclude": [
    "example/",
    "example-firebase/"
  ],
  "compilerOptions": {
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "preserveSymlinks": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["dom", "esnext"],
    "jsx": "react",
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "allowUmdGlobalAccess": true
  }
}
