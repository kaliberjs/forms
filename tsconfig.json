{
  "include": [
    "./components.js",
    "./index.js",
    "./validation.js",
    "./types/**/*",
    "./src/**/*",
    "./typescript/**/*",
  ],
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "preserveSymlinks": true,
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "*": ["./typescript/*"]
    }
  }
}
