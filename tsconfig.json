{
  "include": [
    "./components.js",
    "./index.js",
    "./types.ts",
    "./validation.js",
    "./types/**/*",
    "./src/**/*"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "preserveSymlinks": true,
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowImportingTsExtensions": true,
    "allowUmdGlobalAccess": true,
    "paths": {
      "*": ["./typescript/node_modules/@types/*", "./typescript/node_modules/*", "*"]
    }
  }
}
